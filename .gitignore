# ---------------------------------------------------------------------------
# Dependencies
# ---------------------------------------------------------------------------
node_modules/
.pnpm-store/
.yarn/
jspm_packages/

# ---------------------------------------------------------------------------
# Build output
# ---------------------------------------------------------------------------
dist/
build/
out/
coverage/
*.tsbuildinfo
tsconfig.tsbuildinfo
.tsc-cache/

# ---------------------------------------------------------------------------
# Logs and diagnostics
# ---------------------------------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.jsonl
# `!.gitkeep` used to sit here and did nothing: no rule above matches `.gitkeep`
# (`logs/` and `*.log` do not), and git cannot re-include a file inside an
# excluded directory anyway, so it could not have rescued `logs/.gitkeep` even
# if one existed. The live example of that rule is the `.pi/npm/*` +
# `!/.pi/npm/.npmrc` pair further down, which works only because the directory
# is excluded by CONTENTS rather than by name.

# ---------------------------------------------------------------------------
# Secrets, credentials, local overrides
# Public repo: no credential may ever be committed. Err toward over-excluding.
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.env
auth.json
auth.*.json
credentials.json
*.local.json
*.local.js
*.local.ts
*.local
secrets/
.secrets/
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*
.npmrc
.netrc

