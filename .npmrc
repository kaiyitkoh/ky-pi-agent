# Supply-chain control: pi 1.1.0 package-manager.js passes no --ignore-scripts when it runs
# `npm install` for packages, so lifecycle scripts of installed packages would run.
#
# This file covers installs whose npm cwd is this repo:
#   - a developer's own `npm install` here
#   - the `npm install --omit=dev` Pi runs inside a clone of this repo for
#     `pi install https://github.com/kaiyitkoh/ky-pi-agent`
#
# It does not cover `pi install npm:...`: Pi passes --prefix and npm reads the config from the
# prefix, not cwd. ~/.pi/agent/npm/.npmrc, written by bin/bootstrap.sh, covers that, and
# .pi/npm/.npmrc covers the project-scope prefix.
#
# Not in ~/.npmrc: a global ignore-scripts breaks native builds (sharp, better-sqlite3, node-gyp).
#
# Public repo: never put a registry credential in this file; tests/unit asserts that by pattern.
ignore-scripts=true
save-exact=true
