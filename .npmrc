# ky-pi-agent supply-chain control. See CONTRIBUTING.md and docs/RUNBOOK.md.
#
# Pi runs npm lifecycle scripts with no --ignore-scripts on any code path
# (pi 0.84.1 src/core/package-manager.ts:1750, :1778), while installing
# *itself* with --ignore-scripts (src/config.ts:174) — so the omission is
# deliberate on Pi's side, not an oversight we can wait to be fixed.
#
# This file closes the gap for installs whose npm cwd is this repo:
#   - the developer's own `npm install` inside the repo, and
#   - the `npm install --omit=dev` Pi runs inside a clone of THIS repo when
#     someone runs `pi install https://github.com/kaiyitkoh/ky-pi-agent`
#     (package-manager.ts:1829 — cwd is the clone, which contains this file).
#
# It does NOT cover `pi install npm:...`: Pi passes --prefix and npm resolves
# the project config from --prefix, not from cwd (package-manager.ts:1778).
# That gap is closed by ~/.pi/agent/npm/.npmrc, written by bin/bootstrap.sh.
# The project-scope `pi install -l` variant (prefix <repo>/.pi/npm,
# package-manager.ts:2004) is closed by <repo>/.pi/npm/.npmrc.
#
# Deliberately NOT in ~/.npmrc: a global ignore-scripts breaks legitimate
# native builds (sharp, better-sqlite3, node-gyp) machine-wide. Project scope
# is the user's recorded decision.
#
# This file is committed to a PUBLIC repo. It must never contain a registry
# credential of any kind (auth tokens, per-registry auth lines, passwords).
# tests/unit asserts that by pattern.
ignore-scripts=true
save-exact=true
