# ky-pi-agent — environment variable NAMES only.
#
# bin/bootstrap.sh copies the marked region below into <repo>/.env.example.
# Re-running bootstrap replaces only what is between the markers, so hand-added
# lines outside them survive.
#
# There are no values here and there never will be. Real credentials belong in
# ~/.pi/agent/auth.json — installed from .pi/templates/auth-template.json by
# bin/bootstrap.sh, and interpolated from the environment or a `!command` at
# resolve time — never in this repo, which is public.
#
# KYPI_DASHSCOPE_BASE_URL is an install-time override, not a credential: when it
# is set, bootstrap substitutes it for the shared DashScope host in the models
# template, so a workspace-dedicated URL (whose first label is your workspace id)
# lives only in ~/.pi/agent/models.json and never in git. See RB-03-01 in
# docs/RUNBOOK.md for when to set it.

# ky-pi-agent managed:start
DASHSCOPE_API_KEY=
DEEPSEEK_API_KEY=
AWS_PROFILE=
QODER_PERSONAL_ACCESS_TOKEN=
KYPI_DASHSCOPE_BASE_URL=
# ky-pi-agent managed:end
