// ky-pi-agent provider definitions for Pi's agent-level models.json, as a TEMPLATE.
//
// Pi reads models.json from the agent directory only (pi 1.1.0 dist/config.js:504), so this file does nothing until
// `bin/bootstrap.sh` installs it. Bootstrap merges `providers.dashscope` and the `amazon-bedrock` models below into
// `$PI_AGENT_DIR/models.json`; every other provider, model override and user edit in that file is left alone.
//
// No secret lives here: this repository is public. `apiKey` is the literal `$DASHSCOPE_API_KEY`, interpolated from the
// environment when Pi resolves it; Bedrock credentials stay in auth.json.
//
// `!command` is forbidden anywhere in this file. models.json values are resolved on every request with no caching
// (Pi docs/models.md), so a `!command` would spawn a process on every turn. auth.json caches it for the process.
//
// Every number carries its source or an UNVERIFIED mark. Pi strips whole-line `//` comments (`stripJsonComments`).
//
// One Bedrock model only. Pi's catalogue has Sonnet 4.5 under the bare id and the au., eu., global., jp. and us.
// prefixes but not apac. (pi-ai 1.1.0 dist/providers/data/amazon-bedrock.json). The apac. entry is copied from the
// us. entry; whether AWS serves that profile in the user's account is a live check in docs/RUNBOOK.md.
{
  "providers": {
    "dashscope": {
      "name": "Alibaba Model Studio (DashScope)",
      "api": "openai-completions",
      // The shared international host on purpose. Pi never interpolates `baseUrl` (only `apiKey` and `headers`), so a
      // workspace-dedicated host here would commit an account-identifying literal. `bin/bootstrap.sh` substitutes
      // `$KYPI_DASHSCOPE_BASE_URL` when it is set, so the workspace id lives only in the agent directory.
      "baseUrl": "https://dashscope-intl.aliyuncs.com/compatible-mode/v1",
      "apiKey": "$DASHSCOPE_API_KEY",
      // Written out in full, including fields that match the default: `detectCompat` has no DashScope, Model Studio,
      // `aliyuncs.com` or Qwen branch (pi-ai 1.1.0 dist/api/openai-completions.js:1221), so every field left to
      // detection takes the generic OpenAI default, and both resulting failures are invisible in the UI.
      "compat": {
        // `store` is not in Alibaba's supported-parameter list; the generic default sends `store: false`.
        "supportsStore": false,
        // The `developer` role is unlisted by Alibaba, and Pi emits it only for reasoning models, which these are.
        "supportsDeveloperRole": false,
        // Set explicitly so detection never decides it.
        "supportsReasoningEffort": true,
        // Alibaba lists `max_tokens` and not `max_completion_tokens`, the generic default.
        "maxTokensField": "max_tokens",
        // `strict` is unlisted; suppressing it removes one unlisted field from tool requests.
        "supportsStrictMode": false,
        // The generic default sends `prompt_cache_key` and a 24h `prompt_cache_retention`; neither is in Alibaba's list.
        "supportsLongCacheRetention": false,
        // Pi's "qwen" branch sends top-level `enable_thinking` and `reasoning_effort`, which Alibaba's DeepSeek page
        // documents (alibabacloud.com/help/en/model-studio/deepseek-api); the "deepseek" branch sends a nested
        // `thinking` object it does not. Without this key detection returns "openai" and thinking is never enabled.
        // If the DashScope wire check in docs/RUNBOOK.md shows `enable_thinking` rejected, flip this to "deepseek".
        "thinkingFormat": "qwen"
      },
      "models": [
        {
          // The pro id deliberately equals Pi's built-in DeepSeek-direct id, so the cross-provider invariant test
          // catches a model inheriting the other provider's context window or cost table.
          "id": "deepseek-v4-flash",
          "name": "DeepSeek V4 Flash (DashScope)",
          // Mandatory: every `thinkingFormat` branch and the `reasoning_content` replay require `model.reasoning`, and
          // Pi defaults it to false, which would silently disable thinking and break the second turn of a tool sequence.
          "reasoning": true,
          // Text only; the capability guard reads this field.
          "input": ["text"],
          // "393,216 in total" (alibabacloud.com/help/en/model-studio/deepseek-api). Never copy the 1,000,000 of the
          // identically named DeepSeek-direct model.
          "contextWindow": 393216,
          // UNVERIFIED, deliberately conservative: Alibaba publishes no per-model output cap. docs/RUNBOOK.md's check
          // "the real DashScope context cap and per-token price" measures it.
          "maxTokens": 65536,
          // UNVERIFIED placeholder: Alibaba publishes no per-token price outside the console. The model is on the
          // COST_UNVERIFIED allowlist in tests/unit/model-metadata.test.ts until the same runbook check replaces it.
          "cost": { "input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0 },
          // `low` is null rather than mapped to "high", so the UI never offers a "low" that silently means high.
          "thinkingLevelMap": {
            "minimal": null,
            "low": null,
            "medium": null,
            "high": "high",
            "max": "max"
          },
          // Replayed assistant messages need `reasoning_content: ""`, or the second turn of a tool sequence returns 400.
          "compat": { "requiresReasoningContentOnAssistantMessages": true }
        },
        {
          "id": "deepseek-v4-pro",
          "name": "DeepSeek V4 Pro (DashScope)",
          // Same sources and reasons as deepseek-v4-flash; models.json has no include mechanism.
          "reasoning": true,
          "input": ["text"],
          "contextWindow": 393216,
          // UNVERIFIED, as for flash.
          "maxTokens": 65536,
          // UNVERIFIED placeholder, as for flash.
          "cost": { "input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0 },
          "thinkingLevelMap": {
            "minimal": null,
            "low": null,
            "medium": null,
            "high": "high",
            "max": "max"
          },
          "compat": { "requiresReasoningContentOnAssistantMessages": true }
        }
      ]
    },
    "amazon-bedrock": {
      "models": [
        {
          "id": "apac.anthropic.claude-sonnet-4-5-20250929-v1:0",
          // The name must contain "claude": Pi's prompt-caching and thinking support match on it.
          "name": "Claude Sonnet 4.5 (APAC)",
          "api": "bedrock-converse-stream",
          "reasoning": true,
          "input": ["text", "image"],
          // Copied from the catalogue's us. entry; the apac. price is UNVERIFIED.
          "cost": { "input": 3.3, "output": 16.5, "cacheRead": 0.33, "cacheWrite": 4.125 },
          "contextWindow": 200000,
          "maxTokens": 64000
        }
      ]
    }
  }
}
